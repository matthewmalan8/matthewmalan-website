{
  "name": "matthewmalan-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "prebuild": "node scripts/update-cms-default.mjs && node scripts/fetch-hevy.mjs && node scripts/update-gym-pinned-options.mjs",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "next lint",
    "deploy:aws": "pnpm build && aws s3 sync out/ s3://matthewmalan.com --delete && aws cloudfront create-invalidation --distribution-id E2RKBCXIJZTCSR --paths \"/*\""
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-seo": "^6.6.0",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}
